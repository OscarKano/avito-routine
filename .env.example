# Скопируй этот файл, назови копию просто ".env" (без .example),
# и впиши туда свои значения. Файл .env никому не показывай и не
# отправляй в чат — это твои секретные ключи.

# Ключи с страницы avito.ru/professionals/api ("Получить ключи")
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Токен Telegram-бота (получен через @BotFather) — понадобится позже,
# на шаге публикации. Можно пока оставить пустым.
TELEGRAM_BOT_TOKEN=

# ID твоего Telegram-канала (например -1001234567890) — тоже понадобится
# позже, на шаге публикации.
TELEGRAM_CHANNEL_ID=

# Сколько фото брать из каждого объявления (первые N, без видео)
PHOTOS_PER_POST=8

# Личный Telegram-аккаунт (для чтения каналов поставщиков) — ключи с
# my.telegram.org, раздел "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
